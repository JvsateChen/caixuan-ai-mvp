# ===== 采选AI MVP 环境配置 =====
# 复制本文件为 .env 并填入真实值

# 服务端口
PORT=3000

# ===== AI 双兼容引擎配置 =====
# 填入大模型 API Key 则走模式 A（大模型）；留空则自动降级模式 B（规则解析）
LLM_API_KEY=
# OpenAI 兼容格式的大模型接口地址（支持豆包/通义/DeepSeek/OpenAI 等）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-pro-32k

# ===== 可插拔数据源配置（预留，MVP 用 mock） =====
# 切换数据源：mock | taobao | jd | pdd | alibaba1688 | aggregate
DATA_SOURCE=mock

# 各联盟接入位（MVP 阶段留空，接入真实 API 时填）
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
JD_APP_KEY=
JD_APP_SECRET=
PDD_APP_KEY=
PDD_APP_SECRET=
ALI1688_APP_KEY=
ALI1688_APP_SECRET=
